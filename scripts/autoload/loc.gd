const BOT_NAMES := ["Blaze", "Comet", "Turbo", "Viper", "Nova", "Bolt", "Rogue", "Falcon",
	"Raptor", "Spike", "Jet", "Orbit", "Flash", "Titan", "Ace"]


func lang_index() -> int:
	return 1 if str(Settings.get_value("language", "ar")) == "ar" else 0


func is_rtl() -> bool:
	return lang_index() == 1


func t(key: String) -> String:
	if not STRINGS.has(key):
		return key
	return STRINGS[key][lang_index()]
