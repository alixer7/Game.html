; Engine configuration file.
; Generated for Nitro Fury Racing (Godot 4.4.1-stable)

config_version=5

[application]

config/name="Nitro Fury Racing"
config/description="CTR-inspired high-skill mobile 3D kart racing game with Reserves, Sacred Fire, Blue Fire, Air-Brake U-Turns, interconnected track zones, and hidden aerial shortcuts."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
ProceduralTextures="*res://scripts/autoload/ProceduralTextures.gd"
AudioSynth="*res://scripts/autoload/AudioSynth.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Cairo-Bold.ttf"

