[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="TrackRoad"
3d_physics/layer_2="TrackWall"
3d_physics/layer_3="TrackOffroad"
3d_physics/layer_4="TrackIce"
3d_physics/layer_5="Kart"
3d_physics/layer_6="Interactable"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3
common/physics_jitter_fix=0.5
3d/default_gravity=34.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
scaling_3d/scale=0.85
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.16, 0.42, 0.72, 1)
