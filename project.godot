; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="أرض البقاء - Wildlands"
config/description="لعبة بقاء و Sandbox ثلاثية الأبعاد للهواتف"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/quit_on_go_back=false
config/icon="res://icon.svg"

[autoload]

ItemDB="*res://scripts/data/item_db.gd"
RecipeDB="*res://scripts/data/recipe_db.gd"
BuildDB="*res://scripts/data/build_db.gd"
ResDB="*res://scripts/data/res_db.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/custom_font="res://assets/fonts/Cairo.ttf"
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/physics_engine="DEFAULT"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
rendering_device/fallback_to_opengl3=true

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/standalone_ternary=0
